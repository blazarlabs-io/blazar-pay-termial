# Merchant Next.js app origin (no trailing slash)
MERCHANT_BASE_URL=https://merchant.blazarlabs.io

# Blazar Hydra L2 API
HYDRA_API_URL=https://blazar-api.cardano.vip

# Poll /api/terminal/pending-payment while idle (ms)
TERMINAL_POLL_INTERVAL_MS=1000

# POST /api/terminal/heartbeat for dashboard “terminal online” icon (ms)
TERMINAL_HEARTBEAT_INTERVAL_MS=5000
